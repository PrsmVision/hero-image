{
  "name": "quartz5-component-port",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Local Quartz 5 component plugin for HeroImage and Contributors.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck"
  },
  "peerDependencies": {
    "preact": "^10.28.2"
  },
  "dependencies": {
    "@quartz-community/types": "github:quartz-community/types"
  },
  "devDependencies": {
    "preact": "^10.28.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "quartz": {
    "name": "quartz5-component-port",
    "displayName": "Quartz 5 Ported Components",
    "category": [
      "component"
    ],
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOptions": {},
    "components": {
      "HeroImage": {
        "displayName": "Hero Image",
        "defaultPosition": "beforeBody",
        "defaultPriority": 5
      },
      "Contributors": {
        "displayName": "Contributors",
        "defaultPosition": "afterBody",
        "defaultPriority": 20
      }
    }
  }
}
